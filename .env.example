# Local development defaults. Change passwords outside development.
MYSQL_DATABASE=smart_exam
MYSQL_USER=smart_exam
MYSQL_PASSWORD=smart_exam_dev
MYSQL_ROOT_PASSWORD=root_dev_only
# connectionTimeZone + forceConnectionTimeZoneToSession 保证数据库会话时区也是 UTC，
# 否则 started_at 这类由数据库生成的时间会按本地时区写入、按 UTC 读出，产生时区偏移。
DB_URL='jdbc:mysql://localhost:3306/smart_exam?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true'
DB_USERNAME=smart_exam
DB_PASSWORD=smart_exam_dev
JWT_SECRET=replace-with-at-least-32-random-bytes

# 以下六项是「系统设置」页里可由管理员修改的参数，这里给的是**默认值**：
# 管理员改过的项保存在 system_setting 表里并覆盖这里的值，点「恢复默认」则删掉覆盖、重新跟随本文件。
# 因此改这几个变量只影响没有被覆盖过的项，改完需要重启后端才会成为新的默认值。
JWT_ACCESS_TOKEN_MINUTES=60
EXAM_PASS_RATIO_PERCENT=60
QUESTION_IMPORT_MAX_ROWS=200
QUESTION_IMPORT_SKIP_DUPLICATE_STEM=true
PAPER_AUTO_COMPOSE_MAX_QUESTIONS=50
PRACTICE_BATCH_SIZE=10

# 自动交卷扫描间隔（毫秒）。这一项**只能**改环境变量：@Scheduled 的触发器在启动时注册，
# 做成界面可编辑只会造成「界面改完但进程没变」，因此它不在可编辑白名单里。
EXAM_AUTO_SUBMIT_INTERVAL_MS=30000

# AI 辅助出题（可选）。留空则该功能不可用，手工出题和考试主流程不受影响。
# AI_PROTOCOL 取 openai 或 anthropic：
#   openai    → 请求 ${AI_BASE_URL}/chat/completions，地址要带到版本段，如 https://api.deepseek.com/v1
#   anthropic → 请求 ${AI_BASE_URL}/v1/messages，地址只到域名，如 https://api.anthropic.com
# 换服务商（DeepSeek、通义、Kimi、本地 vLLM/Ollama、Anthropic）只改这四个变量，不改代码。
# AI 的四项配置刻意都不进「系统设置」的可编辑白名单：密钥绝不能出现在浏览器里，
# 地址与协议一旦可编辑就等于把「后端向哪个地址发请求」做成了一个界面输入框；
# 而读超时在启动时就写进了 HTTP 客户端，界面上改了也不会生效。
AI_PROTOCOL=openai
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=2048

# Public frontend build setting; never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api
